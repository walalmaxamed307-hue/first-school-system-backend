# Copy to .env and fill in your own values.

# Local MongoDB (after installing MongoDB Community Server):
MONGODB_URI=mongodb://localhost:27017/schoolapp

# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/schoolapp

PORT=3000

# Sax u dhig — string aad u dheer oo random ah, halkan waxaan ku qoray
# hal tusaale oo development-only ah. Ha isticmaalin production-ka.
JWT_SECRET=dev-only-change-this-to-a-long-random-string

# Origins-ka frontend-ka ee loo ogolyahay inay API-ga wacaan (comma-separated).
# Dev: Vite wuxuu ku shaqeeyaa http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Kaliya haddii server-ku ka dambeeyo reverse proxy (Render/Railway/Nginx):
# TRUST_PROXY=1

# Platform admin (owner) — seed.js (`npm run seed`) wuxuu ka akhriyaa halkan.
# Ku qor qiimayaashaada gaarka ah .env-ka (MA aha .env.example) — .env
# waa ignore-garaysan, sidaas darteed GitHub kuma gaaro.
# Password: ugu yaraan 8 xaraf.
PLATFORM_ADMIN_NAME=Platform Owner
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Login rate-limit (ka hortag brute-force): ugu badnaan isku-day / 15 daqiiqo
# ee IP + account (email ama studentCode) isku mid ah. Login guulaystay ma tirinayo.
LOGIN_MAX_ATTEMPTS=5
# Daboolid IP oo dhan (isku-day fashilmay, account kasta): iskuul dhan hal IP ayuu wadaagi karaa.
LOGIN_MAX_ATTEMPTS_PER_IP=20
